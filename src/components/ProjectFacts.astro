---
interface Props {
  period?: string;
  platforms?: string;
  stack: string[];
  /** The live project's address, if it has one. */
  url?: string;
  /** Public source repositories. */
  repos?: string[];
  /**
   * "aside" (default) sits beside the About text as a card of label/value rows; "strip" is for a
   * project with no About text: the facts run across the page in columns under the media.
   */
  layout?: "aside" | "strip";
}

const { period, platforms, stack, url, repos = [], layout = "aside" } = Astro.props;
const arrow = "M5 11 11 5M6 5h5v5";
---

{/* The facts about a project: when, where it runs, what it's built with, and its links */}
<dl class:list={["project-facts", layout === "strip" && "project-facts--strip"]}>
  {
    period && (
      <div>
        <dt>When</dt>
        <dd>{period}</dd>
      </div>
    )
  }
  {
    platforms && (
      <div>
        <dt>Platform</dt>
        <dd>{platforms}</dd>
      </div>
    )
  }
  <div>
    <dt>Stack</dt>
    <dd>
      <span class="flex flex-wrap gap-1.5">
        {stack.map((tech) => <span class="tech-pill">{tech}</span>)}
      </span>
    </dd>
  </div>
  {
    url && (
      <div>
        <dt>Live</dt>
        <dd>
          <a href={url} class="project-facts-link">
            {new URL(url).hostname}
            <svg class="project-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={arrow} />
            </svg>
          </a>
        </dd>
      </div>
    )
  }
  {
    repos.length > 0 && (
      <div>
        <dt>GitHub</dt>
        <dd class="flex flex-col gap-1.5">
          {repos.map((repo) => (
            <a href={repo} class="project-facts-link">
              {new URL(repo).pathname.split("/").pop()}
              <svg class="project-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={arrow} />
              </svg>
            </a>
          ))}
        </dd>
      </div>
    )
  }
</dl>
