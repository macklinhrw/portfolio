---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "@/lib/utils";

interface Props {
  posts: CollectionEntry<"blog">[];
  class?: string;
}

const { posts, class: className } = Astro.props;
---

<ul class:list={["divide-y border-t", className]}>
  {
    posts.map((post) => (
      <li>
        <a
          href={`/blog/${post.id}`}
          class="group grid gap-x-6 gap-y-0.5 py-4 sm:grid-cols-[1fr_auto]"
        >
          <h3 class="text-[16.5px] leading-snug font-medium tracking-[-0.01em] decoration-brand decoration-[1.5px] underline-offset-4 group-hover:underline">
            {post.data.title}
          </h3>
          <time
            datetime={post.data.pubDate.toISOString()}
            class="row-start-3 text-[13.5px] text-muted-foreground tabular-nums sm:col-start-2 sm:row-start-1 sm:pt-0.5"
          >
            {formatDate(post.data.pubDate)}
          </time>
          <p class="max-w-[58ch] text-[15px] leading-relaxed text-subtle-foreground sm:col-start-1">
            {post.data.description}
          </p>
        </a>
      </li>
    ))
  }
</ul>
