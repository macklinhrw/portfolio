---
import type { CollectionEntry } from "astro:content";
import ProjectIcon from "@/components/ProjectIcon.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
  class?: string;
}

const { projects, class: className } = Astro.props;
---

<ul class:list={["-mx-4 flex flex-col gap-2", className]}>
  {
    projects.map((project) => {
      const { name, description, stack, icon, iconImage, editions, hue } = project.data;
      return (
        <li>
          <a href={`/projects/${project.id}`} class="project-row project-tint" style={hue !== undefined ? `--hue: ${hue}` : undefined}>
            {iconImage ? (
              <span class="project-tile project-tile--image">
                <img src={iconImage} alt="" />
              </span>
            ) : (
              <span class="project-tile">
                <ProjectIcon icon={icon} class="size-[34px]" />
              </span>
            )}
            <span class="project-name">
              {name}
              <svg
                class="project-arrow"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 11 11 5M6 5h5v5" />
              </svg>
            </span>
            {editions ? (
              <span class="project-editions">
                {editions.map((edition) => (
                  <span class="project-edition">
                    <span class="project-edition-label">{edition.label}</span>
                    <span class="project-edition-description">{edition.description}</span>
                    <span class="project-stack" aria-label="Built with">
                      {edition.stack.map((tech) => (
                        <span class="tech-pill">{tech}</span>
                      ))}
                    </span>
                  </span>
                ))}
              </span>
            ) : (
              <>
                <span class="project-description">{description}</span>
                <span class="project-stack" aria-label="Built with">
                  {stack.map((tech) => (
                    <span class="tech-pill">{tech}</span>
                  ))}
                </span>
              </>
            )}
          </a>
        </li>
      );
    })
  }
</ul>
