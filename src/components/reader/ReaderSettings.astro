---
// Reading settings for posts: text size, page colour and font. The choice is stored in
// localStorage and applied before first paint by the inline script in ReaderHead.astro.

const PAGES = [
  // The site's own page, in whichever theme the site is set to (see --site-bg in global.css)
  { id: "site", label: "Site", bg: "var(--site-bg)", fg: "var(--site-fg)", line: "var(--site-line)" },
  { id: "paper", label: "Paper", bg: "#f6f5f1", fg: "#1d1d20", line: "#cfcdc6" },
  { id: "sepia", label: "Sepia", bg: "#f1e7d4", fg: "#3a2e21", line: "#cdbb9b" },
  { id: "night", label: "Night", bg: "#0e0f12", fg: "#c3c3c9", line: "#2c2d33" },
];
const FONTS = [
  { id: "serif", label: "Serif", family: "var(--font-reader-serif)" },
  { id: "sans", label: "Sans", family: "var(--font-sans)" },
];
---

<div class="reader-settings-anchor">
  <button
    type="button"
    class="reader-icon-btn"
    data-reader-settings-toggle
    aria-label="Reading settings"
    aria-expanded="false"
    aria-controls="reader-settings"
  >
    <svg viewBox="0 0 20 20" aria-hidden="true">
      <path d="M2.5 15.5 6.5 4.5h1l4 11M3.8 12h6.4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
      <path d="M12.5 15.5l2.6-7h.8l2.6 7M13.4 13h4.2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </button>

  <div class="reader-settings" id="reader-settings" role="dialog" aria-label="Reading settings" hidden>
    <div class="rs-head">
      <span>Reading settings</span>
      <button type="button" class="rs-reset" data-reader-reset>Reset</button>
    </div>

    <p class="rs-label" id="rs-size-label">Text size</p>
    <div class="rs-stepper" role="group" aria-labelledby="rs-size-label">
      <button type="button" data-reader-size="-1" aria-label="Smaller text">A</button>
      <span data-reader-size-label aria-live="polite">Default</span>
      <button type="button" data-reader-size="1" aria-label="Larger text" class="rs-big">A</button>
    </div>

    <p class="rs-label" id="rs-page-label">Page</p>
    <div class="rs-pages" role="radiogroup" aria-labelledby="rs-page-label">
      {
        PAGES.map((p) => (
          <button
            type="button"
            role="radio"
            class="rs-page"
            data-reader-theme={p.id}
            style={`--p-bg:${p.bg};--p-fg:${p.fg};--p-line:${p.line}`}
          >
            <span class="rs-page-preview" aria-hidden="true">
              <span class="rs-page-aa">Aa</span>
              <span class="rs-page-lines">
                <i />
                <i />
                <i />
              </span>
              <svg class="rs-check" viewBox="0 0 16 16">
                <path d="M4 8.5 6.8 11 12 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="rs-name">{p.label}</span>
          </button>
        ))
      }
    </div>

    <p class="rs-label" id="rs-font-label">Font</p>
    <div class="rs-fonts" role="radiogroup" aria-labelledby="rs-font-label">
      {
        FONTS.map((f) => (
          <button type="button" role="radio" class="rs-font" data-reader-font={f.id}>
            <span class="rs-font-aa" style={`font-family:${f.family}`} aria-hidden="true">
              Aa
            </span>
            <span class="rs-name">{f.label}</span>
          </button>
        ))
      }
    </div>

    <div class="rs-switch-row">
      <span id="rs-justify-label">
        Justify text
        <small>Straight edges, with words hyphenated</small>
      </span>
      <button type="button" role="switch" class="rs-switch" data-reader-justify aria-labelledby="rs-justify-label">
        <span class="rs-switch-thumb"></span>
      </button>
    </div>
  </div>
</div>

<script>
  import { READER_DEFAULTS, READER_SIZES, readReaderSettings, applyReaderSettings, type ReaderSettings } from "@/lib/reader-settings";

  const KEY = "reader-settings";
  const root = document.querySelector<HTMLElement>(".reader-settings-anchor");
  if (root) {
    const panel = root.querySelector<HTMLElement>(".reader-settings")!;
    const toggle = root.querySelector<HTMLButtonElement>("[data-reader-settings-toggle]")!;
    let state: ReaderSettings = readReaderSettings();

    const render = () => {
      applyReaderSettings(state);
      root.querySelector("[data-reader-size-label]")!.textContent =
        state.size === READER_DEFAULTS.size ? "Default" : `${READER_SIZES[state.size]}px`;
      root.querySelectorAll<HTMLElement>("[data-reader-theme]").forEach((b) => b.setAttribute("aria-checked", String(b.dataset.readerTheme === state.theme)));
      root.querySelectorAll<HTMLElement>("[data-reader-font]").forEach((b) => b.setAttribute("aria-checked", String(b.dataset.readerFont === state.font)));
      root.querySelector("[data-reader-justify]")!.setAttribute("aria-checked", String(state.justify));
      root.querySelector<HTMLButtonElement>("[data-reader-reset]")!.disabled =
        state.size === READER_DEFAULTS.size &&
        state.theme === READER_DEFAULTS.theme &&
        state.font === READER_DEFAULTS.font &&
        state.justify === READER_DEFAULTS.justify;
      try {
        localStorage.setItem(KEY, JSON.stringify(state));
      } catch {}
    };

    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => setOpen(panel.hasAttribute("hidden")));
    panel.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest("button");
      if (!button) return;
      if (button.dataset.readerSize) {
        state.size = Math.max(0, Math.min(READER_SIZES.length - 1, state.size + Number(button.dataset.readerSize)));
      } else if (button.dataset.readerTheme) {
        state.theme = button.dataset.readerTheme as ReaderSettings["theme"];
      } else if (button.dataset.readerFont) {
        state.font = button.dataset.readerFont as ReaderSettings["font"];
      } else if (button.hasAttribute("data-reader-justify")) {
        state.justify = !state.justify;
      } else if (button.hasAttribute("data-reader-reset")) {
        state = { ...READER_DEFAULTS };
      }
      render();
    });
    document.addEventListener("click", (event) => {
      if (!panel.hasAttribute("hidden") && !root.contains(event.target as Node)) setOpen(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !panel.hasAttribute("hidden")) {
        setOpen(false);
        toggle.focus();
      }
    });
    render();
  }
</script>
