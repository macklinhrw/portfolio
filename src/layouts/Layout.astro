---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Particles from "@/components/Particles.astro";

interface Props {
  title?: string;
  description?: string;
  /**
   * "split": on large screens the page draws its own two-column layout, so the
   * shared header and footer are hidden there and the content area widens.
   * "reader": a full-page reading view that draws its own chrome; no shared header,
   * footer or star field.
   */
  variant?: "default" | "split" | "reader";
}

const { title = "Portfolio", description = "My portfolio", variant = "default" } = Astro.props;
const split = variant === "split";
const reader = variant === "reader";
---

<!doctype html>
<html lang="en" class="dark" data-site-theme="dark" style="color-scheme: dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0d152a" />
    {/* Apply the saved site theme before first paint (see lib/theme.ts); dark is the default. */}
    <script is:inline>
      (() => {
        let light = false;
        try {
          light = localStorage.getItem("theme") === "light";
        } catch {}
        if (!light) return;
        const html = document.documentElement;
        html.dataset.siteTheme = "light";
        html.classList.remove("dark");
        html.style.colorScheme = "light";
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", "#faf7f1");
      })();
    </script>
    {/* While the page scrolls under a still cursor, Safari keeps :hover on whatever row was
        under it. Mark the page as scrolling until the pointer next moves, and the row hover
        styles in global.css stand down meanwhile. */}
    <script is:inline>
      (() => {
        const html = document.documentElement;
        addEventListener("scroll", () => html.setAttribute("data-scrolling", ""), { passive: true });
        addEventListener("pointermove", () => html.removeAttribute("data-scrolling"), { passive: true });
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col overflow-x-clip bg-background text-foreground antialiased">
    {!reader && <Header class={split ? "lg:hidden" : undefined} />}
    {
      reader ? (
        <slot />
      ) : (
        <>
    <main
      class:list={[
        "mx-auto w-full flex-1 px-6",
        split ? "max-w-[728px] lg:max-w-[1200px] lg:px-12" : "max-w-[728px]",
      ]}
    >
      <slot />
    </main>
    <footer
      class:list={["mx-auto mt-24 w-full max-w-[728px] px-6 sm:mt-32", split && "lg:hidden"]}
    >
      <div
        class="flex items-center justify-between border-t pt-6 pb-12 text-[13.5px] text-muted-foreground"
      >
        <span>
          &copy; {new Date().getFullYear()} Macklin
          {split && (
            <Fragment>
              {" · "}Photo by <a href="https://unsplash.com/@claybanks" class="underline-offset-4 transition-colors hover:text-foreground hover:underline">Clay Banks</a>
            </Fragment>
          )}
        </span>
        <a
          href="https://github.com/macklinhrw"
          class="transition-colors hover:text-foreground"
        >
          GitHub
        </a>
      </div>
    </footer>
        </>
      )
    }
    {/* The star field belongs to the home page only. */}
    {split && <Particles />}
  </body>
</html>
