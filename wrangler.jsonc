{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The Worker that serves macklinw.com. The custom domain is attached in the dashboard.
  "name": "portfolio",
  "compatibility_date": "2026-11-01",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Everything else is served straight from the assets; only clips need byte ranges.
    "run_worker_first": ["/media/*"]
  }
}
